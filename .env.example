# ============================================================
# Nexus React — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Supabase
# Required. Obtain from your Supabase project settings:
# https://app.supabase.com/project/<your-project>/settings/api
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CALLBACK_URL=https://your-project.supabase.co/auth/v1/callback
